# CognoDB connection — copy to .env.local and fill in your values
# Get these from: https://console.cognodb.com
COGNODB_URI=bolt+s://<your-instance-id>.databases.cognodb.com
COGNODB_PASSWORD=your_generated_password_here

# Random secret for the one-time seed API endpoint (generate any string)
SEED_SECRET=change_me_to_a_random_string
